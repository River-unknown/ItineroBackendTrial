					"script": {
						"exec": [
							"// Parse the JSON data from the response body\r",
							"var jsonData = pm.response.json();\r",
							"\r",
							"// Check if a 'token' key exists in the response\r",
							"if (jsonData && jsonData.token) {\r",
							"    // If it exists, save its value to our environment variable\r",
							"    pm.environment.set(\"jwt_token\", jsonData.token);\r",
							"    console.log(\"JWT Token saved successfully!\");\r",
							"}"
